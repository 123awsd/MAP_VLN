 using namespace Eigen;
 
 namespace fast_planner {
+namespace {
+bool previewClearanceSafe(const voxel_mapping::MapServer::Ptr &map, const Vector3d &p) {
+  static const double minimum = [] { double v; ros::param::param<double>("/astar/preview_min_clearance", v, 0.0); return v; }();
+  if (minimum <= 0.0) return true;
+  return map->isInBox(p) && p.z() >= 0.8 && p.z() <= 1.5 &&
+         map->getESDF()->getVoxel(p).value >= minimum;
+}
