+bool FrontierFinder::rejectViewpointNear(const Vector3d &failed_pos, const double &radius) {
+  auto best_frontier = frontiers_.end();
+  size_t best_viewpoint = 0;
+  double best_distance = radius;
+  for (auto frontier = frontiers_.begin(); frontier != frontiers_.end(); ++frontier) {
+    for (size_t i = 0; i < frontier->viewpoints_.size(); ++i) {
+      const double distance = (frontier->viewpoints_[i].pos_ - failed_pos).norm();
+      if (distance <= best_distance) {
+        best_distance = distance;
+        best_frontier = frontier;
+        best_viewpoint = i;
+      }
+    }
+  }
+  if (best_frontier == frontiers_.end())
+    return false;
+
+  ROS_WARN("[FrontierFinder] Reject collision-stalled viewpoint at (%.2f, %.2f, %.2f), "
+           "distance %.2f m", failed_pos.x(), failed_pos.y(), failed_pos.z(), best_distance);
+  best_frontier->viewpoints_.erase(best_frontier->viewpoints_.begin() + best_viewpoint);
+  if (best_frontier->viewpoints_.empty()) {
+    ROS_WARN("[FrontierFinder] Frontier %d has no remaining viewpoints; moving it dormant",
+             best_frontier->id_);
+    dormant_frontiers_.splice(dormant_frontiers_.end(), frontiers_, best_frontier);
+  }
+
+  int id = 0;
+  for (auto &frontier : frontiers_)
+    frontier.id_ = id++;
+  return true;
+}
