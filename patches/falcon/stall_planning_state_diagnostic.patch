--- a/exploration_manager.cpp
+++ b/exploration_manager.cpp
@@ -1195,6 +1195,58 @@
 
       if (min_cost_id < 0) {
         if (!select_recovery_target()) {
+          // Optional diagnostics only; no target selection, map updates or route queries.
+          std::string diagnostic_path;
+          ros::param::param<std::string>("/fast_planner/stall_diagnostic_path", diagnostic_path, "");
+          static double last_diagnostic_time = -1e30;
+          const double diagnostic_time = ros::Time::now().toSec();
+          if (!diagnostic_path.empty() && diagnostic_time - last_diagnostic_time >= 10.0) {
+            std::ofstream diagnostic(diagnostic_path, std::ios::app);
+            if (diagnostic) {
+              diagnostic.precision(17);
+              auto number = [&](double value) {
+                if (std::isfinite(value)) diagnostic << value;
+                else diagnostic << "null";
+              };
+              auto sample = [&](const Vector3d &point) {
+                diagnostic << "{\"position\":[" << point.x() << "," << point.y() << "," << point.z()
+                           << "],\"occupancy\":" << static_cast<int>(map_server_->getOccupancy(point))
+                           << ",\"esdf_m\":";
+                number(map_server_->getESDF()->getDistance(point));
+                diagnostic << "}";
+              };
+              diagnostic << "{\"ros_time_s\":" << diagnostic_time
+                         << ",\"reason\":\"no_finite_frontier_or_relocation\",\"current\":";
+              sample(pos);
+              diagnostic << ",\"world_velocity\":[" << vel.x() << "," << vel.y() << "," << vel.z()
+                         << "],\"occupancy_free_code\":" << static_cast<int>(voxel_mapping::OccupancyType::FREE)
+                         << ",\"occupancy_unknown_code\":" << static_cast<int>(voxel_mapping::OccupancyType::UNKNOWN)
+                         << ",\"local_samples\":[";
+              bool first = true;
+              for (int x = -1; x <= 1; ++x) for (int y = -1; y <= 1; ++y) for (int z = -1; z <= 1; ++z) {
+                Vector3d direction(x,y,z);
+                if (direction.norm() == 0) continue;
+                direction.normalize();
+                for (int step = 1; step <= 10; ++step) {
+                  if (!first) diagnostic << ",";
+                  first = false;
+                  sample(pos + direction * (0.05 * step));
+                }
+              }
+              diagnostic << "],\"frontier_candidates\":[";
+              first = true;
+              for (const auto &point : ed_->points_) {
+                if (!first) diagnostic << ",";
+                first = false;
+                diagnostic << "{\"temporarily_blocked\":" << (isTemporarilyBlocked(point) ? "true" : "false")
+                           << ",\"map_state\":";
+                sample(point);
+                diagnostic << "}";
+              }
+              diagnostic << "]}\n";
+              last_diagnostic_time = diagnostic_time;
+            } else ROS_WARN_THROTTLE(10.0, "Stall diagnostic path could not be opened");
+          }
           ROS_ERROR("[ExplorationManager] No finite frontier candidate or reachable HGrid "
                     "relocation center");
           return FAIL;
