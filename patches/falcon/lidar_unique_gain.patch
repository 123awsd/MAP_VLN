+  } else if (fov_type_ == OMNI_LIDAR) {
+    // Ray endpoints for unknown-space gain, matching the configured lidar FOV.
+    // Keep the historical member name for compatibility with the evaluator.
+    cam_fov_voxels_.clear();
+    for (double azimuth = -M_PI; azimuth < M_PI; azimuth += M_PI / 90.0) {
+      for (int j = 0; j <= 4; ++j) {
+        const double elevation = -bottom_angle_ + (top_angle_ + bottom_angle_) * j / 4.0;
+        cam_fov_voxels_.push_back(max_dist_ * Vector3d(
+            cos(elevation) * cos(azimuth), cos(elevation) * sin(azimuth), sin(elevation)));
+      }
+    }
+    ROS_INFO("[LidarGain] initialized %zu lidar gain rays", cam_fov_voxels_.size());
   }
 }
 
