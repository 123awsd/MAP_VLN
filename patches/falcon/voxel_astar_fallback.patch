diff --git a/falcon_planner/exploration_manager/include/exploration_manager/exploration_manager.h b/falcon_planner/exploration_manager/include/exploration_manager/exploration_manager.h
--- a/falcon_planner/exploration_manager/include/exploration_manager/exploration_manager.h
