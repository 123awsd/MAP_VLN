   replan_pub_ = nh.advertise<std_msgs::Int32>("/planning/replan", 10);
+  // Opt-in offline gate feedback. Never subscribe in normal flight/simulation.
+  bool gate_feedback = false;
+  nh.param("/exploration_manager/preview_tracking_recovery", gate_feedback, false);
+  if (gate_feedback) {
+    static ros::Subscriber gate_sub = nh.subscribe<std_msgs::Int32>(
+        "/preview/motion_blocked", 1, [this](const std_msgs::Int32::ConstPtr &msg) {
+          if (state_ != EXEC_TRAJ && state_ != PUB_TRAJ) return;
+          ROS_WARN("[PreviewGateFeedback] blocked trajectory %d; stop and replan from odometry", msg->data);
+          std_msgs::Int32 stop; stop.data = 1;
+          replan_pub_.publish(stop);
+          fd_->static_state_ = true;
+          transitState(PLAN_TRAJ, "PreviewGateFeedback");
+        });
+  }
@@ -307,1 +307,13 @@
+    bool preview_tracking_recovery = false;
+    ros::param::param<bool>("/exploration_manager/preview_tracking_recovery", preview_tracking_recovery, false);
+    if (preview_tracking_recovery && !fd_->static_state_) {
+      LocalTrajData *tracked = &planner_manager_->local_data_;
+      const double elapsed = std::max(0.0, std::min(tracked->duration_,
+          (ros::Time::now() - tracked->start_time_).toSec()));
+      const double error = (tracked->position_traj_.evaluateDeBoorT(elapsed) - fd_->odom_pos_).norm();
+      if (error > 0.35) {
+        ROS_WARN("[PreviewTrackingRecovery] tracking error %.3f m; replan from measured odometry", error);
+        fd_->static_state_ = true;
+      }
+    }
     if (fd_->static_state_) {
@@ -487,1 +499,20 @@
+    bool preview_final_guard = false;
+    ros::param::param<bool>("/exploration_manager/preview_tracking_recovery", preview_final_guard, false);
+    if (preview_final_guard) {
+      auto &final_path = planner_manager_->local_data_.position_traj_;
+      const double duration = final_path.getTimeSum();
+      const int samples = std::max(1, int(std::ceil(duration / 0.02)));
+      bool valid_height = true;
+      for (int i = 0; i <= samples; ++i) {
+        const double z = final_path.evaluateDeBoorT(duration * i / samples).z();
+        if (!std::isfinite(z) || z < 0.8 || z > 1.5) { valid_height = false; break; }
+      }
+      if (!valid_height) {
+        expl_manager_->blockViewpoint(expl_manager_->ed_->next_pos_, 60.0,
+            "final published trajectory outside preview height band");
+        fd_->static_state_ = true;
+        transitState(PLAN_TRAJ, "PreviewFinalHeightGuard");
+        break;
+      }
+    }
