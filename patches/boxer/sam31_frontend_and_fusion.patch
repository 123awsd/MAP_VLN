@@ -0,0 +1,162 @@
+"""Grounding DINO adapter with the same interface as OwlWrapper.
+
+The Boxer pipeline expects boxes in ``x1, x2, y1, y2`` order and labels as
+strings.  Keeping that interface lets Grounding DINO replace only the 2-D
+proposal stage; BoxerNet and the downstream 3-D fusion remain unchanged.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+from PIL import Image
+from transformers import GroundingDinoForObjectDetection, GroundingDinoProcessor
+from torchvision.ops import nms
+
+
+class GroundingDinoWrapper:
+    def __init__(
+        self,
+        device="cuda",
+        text_prompts=None,
+        min_confidence=0.25,
+        text_threshold=0.20,
+        model_name=None,
+        prompt_batch_size=24,
+        use_sam2=False,
+        sam2_model_name=None,
+        sam2_mask_threshold=0.0,
+    ):
+        self.device = torch.device(device if device != "mps" else "cpu")
+        self.prompts = [str(item).strip().lower().rstrip(".") for item in (text_prompts or [])]
+        self.prompts = [item for item in self.prompts if item]
+        if not self.prompts:
+            raise ValueError("Grounding DINO requires at least one text prompt")
+        self.min_confidence = float(min_confidence)
+        self.text_threshold = float(text_threshold)
+        self.nms_iou = float(os.environ.get("PRE_MAP_VLN_GROUNDING_DINO_NMS_IOU", "0.50"))
+        self.cross_label_nms_iou = float(
+            os.environ.get("PRE_MAP_VLN_GROUNDING_DINO_CROSS_NMS_IOU", "0.90")
+        )
+        self.max_detections = int(
+            os.environ.get("PRE_MAP_VLN_GROUNDING_DINO_MAX_DETECTIONS", "64")
+        )
+        self.last_detections = []
+        self.prompt_batch_size = int(
+            os.environ.get("PRE_MAP_VLN_GROUNDING_DINO_PROMPT_BATCH_SIZE", prompt_batch_size)
+        )
+        if self.prompt_batch_size <= 0:
+            raise ValueError("Grounding DINO prompt batch size must be positive")
+        model_name = model_name or os.environ.get(
+            "PRE_MAP_VLN_GROUNDING_DINO_MODEL",
+            "IDEA-Research/grounding-dino-base",
+        )
+        print(f"==> Loading Grounding DINO: {model_name} on {self.device}", flush=True)
+        self.processor = GroundingDinoProcessor.from_pretrained(model_name)
+        self.model = GroundingDinoForObjectDetection.from_pretrained(model_name).to(self.device)
+        self.model.eval()
+        self.segmenter = None
+        if use_sam2:
+            from sam2_box_segmenter import Sam2BoxSegmenter
+
+            self.segmenter = Sam2BoxSegmenter(
+                device=self.device,
+                model_name=sam2_model_name,
+                mask_threshold=sam2_mask_threshold,
+            )
+
+    @torch.inference_mode()
+    def forward(self, image_torch, resize_to_HW=None):
+        if image_torch.ndim != 4 or image_torch.shape[0] != 1:
+            raise ValueError("input image should have shape [1, 3, H, W]")
+        image = image_torch[0].detach().clamp(0, 255).byte().permute(1, 2, 0).cpu().numpy()
+        pil_image = Image.fromarray(image, mode="RGB")
+        boxes = []
+        scores = []
+        labels = []
+        self.last_unmapped_detections = []
+        target_sizes = torch.tensor([pil_image.size[::-1]], device=self.device)
+        for start in range(0, len(self.prompts), self.prompt_batch_size):
+            prompt_batch = self.prompts[start : start + self.prompt_batch_size]
+            inputs = self.processor(
+                images=pil_image,
+                text=[prompt_batch],
+                return_tensors="pt",
+            )
+            inputs = {
+                key: value.to(self.device) if hasattr(value, "to") else value
+                for key, value in inputs.items()
+            }
+            if inputs["input_ids"].shape[-1] > self.model.config.max_text_len:
+                raise ValueError(
+                    "Grounding DINO prompt batch exceeds the model text limit; "
+                    "reduce PRE_MAP_VLN_GROUNDING_DINO_PROMPT_BATCH_SIZE"
+                )
+            outputs = self.model(**inputs)
+            result = self.processor.post_process_grounded_object_detection(
+                outputs,
+                inputs["input_ids"],
+                threshold=self.min_confidence,
+                text_threshold=self.text_threshold,
+                target_sizes=target_sizes,
+            )[0]
+            for box, score, label in zip(result["boxes"], result["scores"], result["text_labels"]):
+                x1, y1, x2, y2 = box.detach().cpu().tolist()
+                width = x2 - x1
+                height = y2 - y1
+                if width <= 0 or height <= 0:
+                    continue
+                if width > 0.95 * pil_image.width or height > 0.95 * pil_image.height:
+                    continue
+                normalized_label = str(label).strip().lower().rstrip(".")
+                if normalized_label not in self.prompts:
+                    self.last_unmapped_detections.append({
+                        "raw_label": normalized_label, "score": float(score),
+                        "bbox_xyxy": [x1, y1, x2, y2],
+                        "reason": "no exact prompt match; no fallback to first class",
+                    })
+                    continue
+                boxes.append([x1, x2, y1, y2])
+                scores.append(float(score))
+                labels.append(normalized_label)
+        if not boxes:
+            self.last_detections = []
+            return torch.zeros((0, 4)), torch.zeros(0), torch.zeros(0, dtype=torch.long), None
+        # Suppress repeated proposals produced within and across prompt batches.
+        standard_boxes = torch.tensor(
+            [[box[0], box[2], box[1], box[3]] for box in boxes], dtype=torch.float32
+        )
+        score_tensor = torch.tensor(scores, dtype=torch.float32)
+        kept = []
+        for label in dict.fromkeys(labels):
+            indices = torch.tensor([i for i, item in enumerate(labels) if item == label])
+            local = nms(standard_boxes[indices], score_tensor[indices], self.nms_iou)
+            kept.extend(indices[local].tolist())
+        kept_tensor = torch.tensor(kept, dtype=torch.long)
+        cross_kept = nms(
+            standard_boxes[kept_tensor], score_tensor[kept_tensor], self.cross_label_nms_iou
+        )
+        kept = kept_tensor[cross_kept].tolist()
+        kept.sort(key=lambda index: scores[index], reverse=True)
+        kept = kept[: self.max_detections]
+        boxes = [boxes[index] for index in kept]
+        scores = [scores[index] for index in kept]
+        labels = [labels[index] for index in kept]
+        self.last_detections = [
+            {
+                "label": label,
+                "score": float(score),
+                "bbox_xyxy": [float(box[0]), float(box[2]), float(box[1]), float(box[3])],
+            }
+            for box, score, label in zip(boxes, scores, labels)
+        ]
+        label_indices = torch.tensor(
+            [self.prompts.index(label) for label in labels],
+            dtype=torch.long,
+        )
+        masks = None
+        if self.segmenter is not None:
+            boxes_xyxy = [[box[0], box[2], box[1], box[3]] for box in boxes]
+            masks = self.segmenter.segment(pil_image, boxes_xyxy)
+        return torch.tensor(boxes, dtype=torch.float32), torch.tensor(scores), label_indices, masks
