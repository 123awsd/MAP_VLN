Panels:
- Class: rviz/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 363
- Class: rviz/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Current Tool: rviz/MoveCamera
  Displays:
  - Alpha: 0.3499999940395355
    Cell Size: 1
    Class: rviz/Grid
    Color: 80; 80; 80
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 15.106938362121582
      Min Value: -14.99693775177002
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 255; 255; 255
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: FAST-LIO map
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.029999999329447746
    Style: Points
    Topic: /drone_room/map
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 0.3299999952316284
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 30; 210; 70
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Full volume - traversable (optional)
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.24500000417232512
    Style: Boxes
    Topic: /drone_room/inflated_free
    Unreliable: false
    Use Fixed Frame: true
    Value: false
  - Alpha: 0.30000001192092896
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 245; 55; 35
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Full volume - clearance blocked (optional)
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.24500000417232512
    Style: Boxes
    Topic: /drone_room/inflation_excluded
    Unreliable: false
    Use Fixed Frame: true
    Value: false
  - Alpha: 0.07999999821186066
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 150; 150; 150
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: false
    Name: Unknown / not observed
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.24500000417232512
    Style: Boxes
    Topic: /drone_room/unknown
    Unreliable: false
    Use Fixed Frame: true
    Value: false
  - Class: rviz/MarkerArray
    Enabled: false
    Marker Topic: /drone_room/traversability_slice
    Name: Combined volume below max Z (optional)
    Namespaces:
      slice_clearance_blocked: true
      slice_occupied: true
      slice_traversable: true
      slice_unknown: false
    Queue Size: 10
    Value: false
  - Class: rviz/MarkerArray
    Enabled: false
    Marker Topic: /drone_room/traversability_slice/safe
    Name: SAFE below max Z - traversable (green, optional)
    Queue Size: 10
    Value: false
  - Alpha: 0.55
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 255; 120; 5
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: UNSAFE below max Z - insufficient clearance (orange)
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.096
    Style: Boxes
    Topic: /drone_room/traversability_points/clearance_blocked
    Unreliable: false
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.9
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Max Value: 1
      Min Value: 0
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 255; 0; 0
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 150; 0; 0
    Min Color: 255; 185; 185
    Name: OCCUPIED below max Z - mapped obstacle (red)
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.096
    Style: Boxes
    Topic: /drone_room/traversability_points/occupied
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Class: rviz/MarkerArray
    Enabled: false
    Marker Topic: /drone_room/traversability_slice/unknown
    Name: UNKNOWN below max Z - not observed (gray)
    Queue Size: 10
    Value: false
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /drone_room/targets
    Name: Semantic 3D boxes and labels
    Namespaces:
      semantic_boxes: true
      semantic_labels: true
      trajectory_clearance: true
      trajectory_clearance_labels: true
      trajectory_occupied_conflicts: true
    Queue Size: 100
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /drone_room/clicked_point
    Name: Clicked point coordinate
    Queue Size: 10
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz/Path
    Color: 80; 220; 255
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Lines
    Line Width: 0.05999999865889549
    Name: FAST-LIO trajectory
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Queue Size: 10
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic: /drone_room/trajectory
    Unreliable: false
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz/Path
    Color: 255; 235; 40
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.14000000059604645
    Name: planned path
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Queue Size: 10
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic: /drone_room/planned_path
    Unreliable: false
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/Select
  - Class: rviz/PublishPoint
    Single click: true
    Topic: /clicked_point
  Value: true
  Views:
    Current:
      Angle: 0.0
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering: false
      Invert Z Axis: false
      Name: Auto top-down
      Near Clip Distance: 0.01
      Scale: 25.0
      Target Frame: <Fixed Frame>
      X: 7.949999999999999
      Y: 2.25
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1400
  X: 520
  Y: 143
