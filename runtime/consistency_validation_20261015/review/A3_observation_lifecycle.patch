+void ExplorationManager::cancelObservationCandidate(int id,const std::string &reason){
+  auto it=candidate_observations_.find(id);if(it==candidate_observations_.end())return;
+  replayEvent("observation_candidate_cancelled",",\"task_id\":"+std::to_string(it->second.state.id)+",\"trajectory_id\":"+std::to_string(id)+",\"reason\":\""+reason+"\"");
+  candidate_observations_.erase(it);
+}
+void ExplorationManager::interruptObservation(const std::string &reason){
+  refreshObservation();auto &st=executing_observation_.state;
+  if(st.active()){
+    replayEvent("observation_cancelled",",\"task_id\":"+std::to_string(st.id)+",\"reason\":\"execution_stop:"+reason+"\"");st.cancel();
+  }
+  pending_floor_valid_=false;
+  while(!candidate_observations_.empty())cancelObservationCandidate(candidate_observations_.begin()->first,reason);
