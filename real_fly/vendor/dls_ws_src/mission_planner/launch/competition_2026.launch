<launch>
    <!-- Visualization-only height filters. The planner consumes the unfiltered
         guarded cloud and therefore keeps every collision constraint. -->
    <arg name="rviz" default="true"/>
    <!-- Keep the verified automatic mission by default; disable it when
         testing individual goals through /planning/click_goal. -->
    <arg name="preset_mission" default="true"/>
    <arg name="mission_mode" default="hybrid"/>
    <arg name="d_gate_mode"
         default="$(eval 'super' if arg('mission_mode') == 'super' else 'smooth')"/>
    <arg name="known_map_pcd"
         default="$(find perfect_drone_sim)/pcd/competition_2026.pcd"/>
    <arg name="full_smooth_route"
         default="$(find mission_planner)/data/competition_2026_full_smooth.txt"/>
    <arg name="visualization_min_z" default="-0.05"/>
    <arg name="visualization_max_z" default="2.35"/>
    <!-- The inflated ceiling extends below 2.35 m, so use a lower display-only
         cutoff for inf_occ. This does not change the planner's inflated map. -->
    <arg name="inflated_visualization_max_z" default="2.05"/>

    <node pkg="perfect_drone_sim" type="perfect_drone" name="perfect_drone" output="log">
        <param name="config_name" value="competition_2026.yaml" type="string"/>
    </node>

    <node pkg="mission_planner" name="competition_cloud_guard"
          type="competition_cloud_guard" output="screen">
        <rosparam command="load"
                  file="$(find mission_planner)/config/competition_2026_cloud_guard.yaml"/>
    </node>

    <node pkg="mission_planner" name="competition_command_mux"
          type="competition_command_mux" output="screen"/>

    <node if="$(eval arg('preset_mission') and arg('mission_mode') != 'full_smooth')"
          pkg="mission_planner" name="waypoint_mission" type="waypoint_mission" output="screen">
        <param name="config_name" value="competition_2026_waypoint.yaml" type="string"/>
        <param name="data_name" value="competition_2026_waypoints.txt" type="string"/>
        <param name="d_gate_mode" value="$(arg d_gate_mode)" type="string"/>
    </node>

    <node if="$(eval arg('preset_mission') and arg('mission_mode') == 'full_smooth')"
          pkg="mission_planner" name="full_smooth_mission" type="full_smooth_mission" output="screen">
        <param name="route_path" value="$(arg full_smooth_route)"/>
        <param name="known_map_pcd" value="$(arg known_map_pcd)"/>
        <!-- This launch is the simulator entrypoint. Keep the physical recorder
             default isolated from the simulator's 0.18 m SUPER robot model. -->
        <param name="super_config_path"
               value="$(find super_planner)/config/competition_2026.yaml"/>
        <param name="odom_topic" value="/lidar_slam/odom"/>
        <param name="start_trigger_type" value="2"/>
        <param name="start_delay" value="5.0"/>
        <param name="auto_land" value="false"/>
        <param name="min_segment_time" value="0.60"/>
        <param name="collision_clearance" value="0.21"/>
        <param name="max_velocity" value="2.45"/>
        <param name="max_acceleration" value="6.0"/>
        <param name="max_jerk" value="120.0"/>
        <param name="max_snap" value="500.0"/>
        <param name="max_jerk_discontinuity" value="0.0001"/>
        <param name="yaw_start_blend_duration" value="1.0"/>
        <param name="yaw_terminal_blend_duration" value="1.5"/>
        <param name="yaw_velocity_threshold" value="0.08"/>
        <param name="yaw_lookahead_time" value="0.30"/>
        <param name="max_yaw_rate" value="2.5"/>
        <param name="max_yaw_lock_variation" value="1.0"/>
    </node>

    <node unless="$(eval arg('mission_mode') == 'full_smooth')"
          pkg="super_planner" name="fsm_node" type="fsm_node" output="screen">
        <param name="config_name" value="competition_2026.yaml" type="string"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="global_cloud_visualization_filter"
          args="standalone pcl/PassThrough" output="log">
        <remap from="~input" to="/global_pc"/>
        <remap from="~output" to="/competition/global_pc_vis"/>
        <param name="filter_field_name" value="z"/>
        <param name="filter_limit_min" value="$(arg visualization_min_z)" type="double"/>
        <param name="filter_limit_max" value="$(arg visualization_max_z)" type="double"/>
        <param name="filter_limit_negative" value="false"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="local_cloud_visualization_filter"
          args="standalone pcl/PassThrough" output="log">
        <remap from="~input" to="/cloud_registered"/>
        <remap from="~output" to="/competition/cloud_registered_vis"/>
        <param name="filter_field_name" value="z"/>
        <param name="filter_limit_min" value="$(arg visualization_min_z)" type="double"/>
        <param name="filter_limit_max" value="$(arg visualization_max_z)" type="double"/>
        <param name="filter_limit_negative" value="false"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="occupancy_visualization_filter"
          args="standalone pcl/PassThrough" output="log">
        <remap from="~input" to="/fsm_node/rog_map/occ"/>
        <remap from="~output" to="/competition/occ_vis"/>
        <param name="filter_field_name" value="z"/>
        <param name="filter_limit_min" value="$(arg visualization_min_z)" type="double"/>
        <param name="filter_limit_max" value="$(arg visualization_max_z)" type="double"/>
        <param name="filter_limit_negative" value="false"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="inflated_occupancy_visualization_filter"
          args="standalone pcl/PassThrough" output="log">
        <remap from="~input" to="/fsm_node/rog_map/inf_occ"/>
        <remap from="~output" to="/competition/inf_occ_vis"/>
        <param name="filter_field_name" value="z"/>
        <param name="filter_limit_min" value="$(arg visualization_min_z)" type="double"/>
        <param name="filter_limit_max" value="$(arg inflated_visualization_max_z)" type="double"/>
        <param name="filter_limit_negative" value="false"/>
    </node>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="top_down"
              args="-d $(find perfect_drone_sim)/rviz/top_down.rviz" output="log">
            <remap from="/global_pc" to="/competition/global_pc_vis"/>
            <remap from="/cloud_registered" to="/competition/cloud_registered_vis"/>
            <remap from="/fsm_node/rog_map/occ" to="/competition/occ_vis"/>
            <remap from="/fsm_node/rog_map/inf_occ" to="/competition/inf_occ_vis"/>
        </node>
        <node pkg="rviz" type="rviz" name="fpv"
              args="-d $(find perfect_drone_sim)/rviz/fpv.rviz" output="log">
            <remap from="/global_pc" to="/competition/global_pc_vis"/>
            <remap from="/cloud_registered" to="/competition/cloud_registered_vis"/>
            <remap from="/fsm_node/rog_map/occ" to="/competition/occ_vis"/>
            <remap from="/fsm_node/rog_map/inf_occ" to="/competition/inf_occ_vis"/>
        </node>
    </group>
</launch>
