Panels:
  - Class: mission_planner/WaypointRecorderPanel
    Name: Waypoint Recorder
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Accumulated Validation Map1/Autocompute Value Bounds1
      Splitter Ratio: 0.5
    Tree Height: 226
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: Accumulated Validation Map
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: false
    - Alpha: 0.6499999761581421
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 16.50543212890625
        Min Value: -0.12339388579130173
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 220; 220; 220
      Color Transformer: AxisColor
      Decay Time: 3
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Environment Cloud
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.029999999329447746
      Style: Points
      Topic: /cloud_registered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Alpha: 0.6000000238418579
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.1924777030944824
        Min Value: -0.19870977103710175
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 90; 230; 180
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: true
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Accumulated Validation Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.30000001192092896
      Style: Boxes
      Topic: /waypoint_recorder/accumulated_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Angle Tolerance: 0.05000000074505806
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.30000001192092896
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Keep: 1
      Name: UAV Pose
      Position Tolerance: 0.019999999552965164
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 0.699999988079071
        Axes Radius: 0.07999999821186066
        Color: 255; 80; 20
        Head Length: 0.2199999988079071
        Head Radius: 0.1599999964237213
        Shaft Length: 0.550000011920929
        Shaft Radius: 0.05000000074505806
        Value: Axes
      Topic: /waypoint_recorder/odom
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /waypoint_recorder/markers
      Name: Recorded Waypoints
      Namespaces:
        recorded_waypoint_ids: true
        recorded_waypoint_path: true
        recorded_waypoint_yaws: true
        recorded_waypoints: true
      Queue Size: 10
      Value: true
    - Alpha: 1
      Buffer Length: 3
      Class: rviz/Path
      Color: 120; 120; 120
      Enabled: false
      Head Diameter: 0.10000000149011612
      Head Length: 0.07999999821186066
      Length: 0.10000000149011612
      Line Style: Billboards
      Line Width: 0.30000001192092896
      Name: Full Smooth Path (geometry only)
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 255; 255
      Pose Style: None
      Queue Size: 10
      Radius: 0.029999999329447746
      Shaft Diameter: 0.05999999865889549
      Shaft Length: 0.05999999865889549
      Topic: /planning/full_smooth_path
      Unreliable: false
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /planning/full_smooth_markers
      Name: Full Smooth Speed, Yaw and Safety
      Namespaces:
        full_smooth_centerline: true
        full_smooth_safety_envelope: true
        full_smooth_speed: true
        full_smooth_status: true
        full_smooth_yaw: true
      Queue Size: 2
      Value: true
  Enabled: true
  Global Options:
    Background Color: 45; 45; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /planning/click_goal
  Value: true
  Views:
    Current:
      Class: rviz/XYOrbit
      Distance: 17.17131805419922
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398006439209
      Focal Point:
        X: 2.860163688659668
        Y: 6.559572219848633
        Z: -1.212766164826462e-06
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.9797971844673157
      Target Frame: world
      Yaw: 3.1599769592285156
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 836
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Waypoint Recorder:
    collapsed: false
  Width: 1528
  X: 72
  Y: 27