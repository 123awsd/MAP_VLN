<launch>
<!-- Launch file for initial MID360 LiDAR -->

	<arg name="rviz" default="false" />
	<arg name="map_pcd" default="$(eval optenv('GLOBAL_MAP_PCD', 'origin.pcd'))" />
	<arg name="init_x" default="$(eval optenv('INIT_BODY_X', '0.0'))" />
	<arg name="init_y" default="$(eval optenv('INIT_BODY_Y', '0.0'))" />
	<arg name="init_z" default="$(eval optenv('INIT_BODY_Z', '0.0'))" />
	<arg name="init_yaw_deg" default="$(eval optenv('INIT_BODY_YAW_DEG', '0.0'))" />
	<arg name="max_fitness_score" default="$(eval optenv('FAST_LIO_MAX_FITNESS_SCORE', '2.0'))" />
	<arg name="init_mode" default="$(eval optenv('INIT_MODE', 'auto'))" />
	<arg name="scdb_path" default="$(eval optenv('GCS_SCDB', ''))" />
	<arg name="scdb_top_k" default="$(eval optenv('FAST_LIO_SCDB_TOP_K', '5'))" />
	<arg name="scdb_pose_fallback" default="$(eval optenv('FAST_LIO_SCDB_POSE_FALLBACK', 'true'))" />
	<arg name="scdb_accept_fitness" default="$(eval optenv('FAST_LIO_SCDB_ACCEPT_FITNESS', '0.5'))" />

	<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />
	<rosparam command="load" file="$(find fast_lio)/config/initial_align.yaml" />

	<param name="wxx/initial_align/init_mode" value="$(arg init_mode)" />
	<param name="wxx/initial_align/scdb_path" value="$(arg scdb_path)" />
	<param name="wxx/initial_align/scdb_top_k" type="int" value="$(arg scdb_top_k)" />
	<param name="wxx/initial_align/scdb_accept_fitness" type="double" value="$(arg scdb_accept_fitness)" />
	<param name="wxx/initial_align/scdb_pose_fallback" type="bool" value="$(arg scdb_pose_fallback)" />

	<param name="wxx/initial_map_pcd_name" value="$(arg map_pcd)" />
	<param name="wxx/initial_align/Init_Body_pos_x" type="double" value="$(arg init_x)" />
	<param name="wxx/initial_align/Init_Body_pos_y" type="double" value="$(arg init_y)" />
	<param name="wxx/initial_align/Init_Body_pos_z" type="double" value="$(arg init_z)" />
	<param name="wxx/initial_align/Init_Body_yaw_deg" type="double" value="$(arg init_yaw_deg)" />
	<param name="wxx/initial_align/max_fitness_score" type="double" value="$(arg max_fitness_score)" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="2"/>
    <node pkg="fast_lio" type="initial_align" name="initial_align" output="screen" /> 
	
	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
