<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="false" />
	<arg name="map_pcd" default="$(eval optenv('GLOBAL_MAP_PCD', 'origin.pcd'))" />
	<arg name="map_incremental" default="false" />
	<arg name="save_new_map_to_pcd" default="false" />
	<arg name="initial_odom_timeout" default="$(eval optenv('FAST_LIO_ODOM_TIMEOUT', '90.0'))" />

	<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />

	<param name="wxx/initial_map_from_pcd" type="bool" value="1"/>
	<param name="wxx/initial_map_pcd_name" value="$(arg map_pcd)" />
	<param name="wxx/map_incremental" type="bool" value="$(arg map_incremental)" />
	<param name="wxx/save_new_map_to_pcd" type="bool" value="$(arg save_new_map_to_pcd)" />
	<param name="wxx/initial_odom_timeout_sec" type="double" value="$(arg initial_odom_timeout)" />

	<param name="feature_extract_enable" type="bool" value="0"/>

	<param name="point_filter_num" type="int" value="6"/>
	<param name="max_icp_times" type="int" value="2" />
	<param name="max_iteration" type="int" value="4" />
	<param name="filter_size_surf" type="double" value="0.25" />
	<param name="filter_size_map" type="double" value="0.25" />

	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 
    <node pkg="fast_lio" type="cpu_monitor" name="cpu_monitor" output="screen" /> 

	<!-- <node pkg="fast_lio" type="initial_map_publisher" name="initial_map_publisher" output="screen" />  -->

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
