Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Name: TF
      Show Axes: false
      Show Names: false
      Tree:
        camera_color_frame:
          camera_color_optical_frame: {}
        camera_link:
          camera_depth_frame:
            camera_depth_optical_frame: {}
      Update Interval: 0
      Value: true
    - Class: rviz/PointCloud2
      Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 3
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 235; 235; 235
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Accumulated Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic: /Laser_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/PointCloud2
      Alpha: 0.35
      Color: 0; 255; 80
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Registered Point Cloud
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.03
      Style: Points
      Topic: /cloud_registered
      Unreliable: false
      Use Fixed Frame: true
      Use Rainbow: false
      Value: true
    - Class: rviz/Path
      Color: 255; 220; 0
      Enabled: true
      Line Style: Billboards
      Line Width: 0.1
      Name: FAST-LIO Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Pose Size:
        Axes Length: 0.3
        Axes Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.03
        Shaft Length: 0.3
      Topic: /path
      Value: true
    - Class: rviz/Odometry
      Alpha: 1
      Axes Length: 0.4
      Axes Radius: 0.03
      Color: 0; 255; 0
      Enabled: false
      Keep: 100
      Name: FAST-LIO Odometry
      Position Tolerance: 0.1
      Queue Size: 10
      Shape: Arrow
      Topic: /Odometry
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rgb_coverage/frustums
      Name: RGB Seen Frustums
      Namespaces:
        rgb_seen: true
      Queue Size: 10
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rgb_coverage/current_frustum
      Name: RGB Current View
      Namespaces:
        rgb_current: true
      Queue Size: 10
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /rgb_coverage/camera_path
      Name: RGB Camera Path
      Namespaces:
        rgb_camera_path: true
      Queue Size: 10
      Value: true
    - Class: rviz/Image
      Enabled: false
      Image Topic: /camera/color/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: D435 RGB
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: false
    - Class: rviz/Image
      Enabled: false
      Image Topic: /camera/depth/image_rect_raw
      Max Value: 10
      Median window: 5
      Min Value: 0
      Name: D435 Depth
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: world
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: world
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  X: 50
  Y: 50
