# Run-local sensor topic manifest. Copy this file to
# data/<run_id>/topics.env and fill values from the running sensor-only ROS
# master. Do not put credentials or control topics in this file.

LIDAR_TOPIC=
LIDAR_TYPE=
IMU_TOPIC=
IMU_TYPE=sensor_msgs/Imu

RGB_TOPIC=
RGB_TYPE=sensor_msgs/Image
DEPTH_TOPIC=
DEPTH_TYPE=sensor_msgs/Image
RGB_CAMERA_INFO_TOPIC=
RGB_CAMERA_INFO_TYPE=sensor_msgs/CameraInfo
DEPTH_CAMERA_INFO_TOPIC=
DEPTH_CAMERA_INFO_TYPE=sensor_msgs/CameraInfo

# D435i IMU. Fill CAMERA_IMU_TOPIC when the ROS1 driver publishes a fused
# /camera/imu. Otherwise leave it empty and fill both gyro and accel topics.
CAMERA_IMU_TOPIC=
CAMERA_IMU_TYPE=sensor_msgs/Imu
CAMERA_GYRO_TOPIC=
CAMERA_GYRO_TYPE=sensor_msgs/Imu
CAMERA_ACCEL_TOPIC=
CAMERA_ACCEL_TYPE=sensor_msgs/Imu

TF_TOPIC=/tf
TF_TYPE=tf2_msgs/TFMessage
TF_STATIC_TOPIC=/tf_static
TF_STATIC_TYPE=tf2_msgs/TFMessage

# Optional frame labels, recorded in the run manifest when available.
RGB_FRAME_ID=
DEPTH_FRAME_ID=
LIDAR_FRAME_ID=
