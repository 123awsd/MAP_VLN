<launch>
  <arg name="map_name" default="handheld_map.pcd"/>

  <rosparam command="load"
            file="$(find stage1_fast_lio)/../../../config/fast_lio_mid360_handheld.yaml"/>

  <!-- A full KD-tree snapshot at 0.5 Hz is responsive in RViz without
       sending the complete growing map at the 20 Hz LiDAR rate. -->
  <param name="publish/map_en" type="bool" value="true"/>
  <param name="publish/map_interval" type="int" value="40"/>
  <param name="publish/path_en" type="bool" value="true"/>
  <!-- Handheld mapping only: remove the operator in the LiDAR rear half. -->
  <param name="preprocess/handheld_self_filter/enabled" type="bool" value="true"/>
  <param name="wxx/save_new_map_to_pcd" type="bool" value="true"/>
  <param name="wxx/new_map_pcd_name" value="$(arg map_name)"/>

  <node pkg="stage1_fast_lio" type="fastlio_mapping"
        name="laserMapping" output="screen"/>
</launch>
