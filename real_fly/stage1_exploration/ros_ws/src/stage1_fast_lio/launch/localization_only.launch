<launch>
  <!--
    Lightweight online localization profile for Stage 2.

    FAST-LIO must keep its internal incremental map for scan-to-map matching,
    but this profile does not publish/save that map or publish point clouds.
    /Odometry and the world -> body TF remain available to downstream nodes.
  -->
  <rosparam command="load"
            file="$(find stage1_fast_lio)/../../../config/fast_lio_mid360_handheld.yaml"/>

  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="point_filter_num" type="int" value="2"/>
  <param name="max_icp_times" type="int" value="2"/>
  <param name="max_iteration" type="int" value="4"/>
  <param name="filter_size_surf" type="double" value="0.25"/>
  <param name="filter_size_map" type="double" value="0.25"/>
  <param name="cube_side_length" type="double" value="1000"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>
  <!-- Flight localization must retain the full 360-degree surroundings. -->
  <param name="preprocess/handheld_self_filter/enabled" type="bool" value="false"/>

  <param name="publish/path_en" type="bool" value="false"/>
  <param name="publish/scan_publish_en" type="bool" value="false"/>
  <param name="publish/scan_bodyframe_pub_en" type="bool" value="false"/>
  <param name="publish/dense_publish_en" type="bool" value="false"/>
  <param name="publish/debug_circular_scan_publish_en" type="bool" value="false"/>
  <param name="publish/lidar_bins_en" type="bool" value="false"/>
  <param name="publish/map_en" type="bool" value="false"/>
  <param name="pcd_save/pcd_save_en" type="bool" value="false"/>
  <param name="wxx/save_new_map_to_pcd" type="bool" value="false"/>

  <node pkg="stage1_fast_lio" type="fastlio_mapping"
        name="laserMapping" output="screen"/>
</launch>
