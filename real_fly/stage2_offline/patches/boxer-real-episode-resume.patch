+    def save_processing_manifest():
+        counts = {"success": 0, "failed": 0, "skipped": 0}
+        detection_2d_count = 0
+        detection_3d_count = 0
+        for value in processing_manifest["frames"].values():
+            status = value.get("status")
+            if status in counts:
+                counts[status] += 1
+            detection_2d_count += int(value.get("detections_2d", 0))
+            detection_3d_count += int(value.get("detections_3d", 0))
+        processing_manifest["summary"] = {
+            **counts,
+            "detections_2d": detection_2d_count,
+            "detections_3d": detection_3d_count,
+        }
+        processing_manifest["updated_unix_sec"] = time.time()
+        temporary = processing_manifest_path + ".tmp"
+        with open(temporary, "w", encoding="utf-8") as stream:
+            json.dump(processing_manifest, stream, indent=2, sort_keys=True)
+            stream.write("\n")
+        os.replace(temporary, processing_manifest_path)
+
+    def record_frame(
