Panels:
- Class: rviz/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Animated final trajectory1
    Splitter Ratio: 0.5
  Tree Height: 363
- Class: rviz/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz/MarkerArray
    Enabled: true
    Value: true
    Name: Approved room map
    Marker Topic: /lab_rooms/map
    Queue Size: 100
  Enabled: true
  Global Options:
    Background Color: 35; 39; 45
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/MoveCamera
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/Select
  - Class: rviz/PublishPoint
    Single click: true
    Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 19
      Angle: 0
      X: -7
      Y: 5
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1400
  X: 100
  Y: 80
