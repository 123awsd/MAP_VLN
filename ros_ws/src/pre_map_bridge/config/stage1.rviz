Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: false
      Name: Metric Grid (Optional)
      Plane: XY
      Reference Frame: world
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 0; 210; 230
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: FUEL-style Roofless Map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic: /pre_map_vln/roofless_map
      Unreliable: false
      Use Fixed Frame: true
    - Alpha: 0.35
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 80; 165; 255
      Color Transformer: FlatColor
      Decay Time: 0.5
      Enabled: false
      Name: Current Depth Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic: /voxel_mapping/depth_pointcloud
      Unreliable: false
      Use Fixed Frame: true
    - Class: rviz/Marker
      Enabled: false
      Marker Topic: /planning_vis/frontier
      Name: Frontier Labels (Optional)
      Namespaces: {}
      Queue Size: 100
    - Alpha: 0.62
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 210; 0
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Name: Frontier Cells
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.015
      Style: Points
      Topic: /planning_vis/frontier_pcl
      Unreliable: false
      Use Fixed Frame: true
    - Class: rviz/Marker
      Enabled: false
      Marker Topic: /planning_vis/viewpoints
      Name: Candidate Viewpoints
      Namespaces: {}
      Queue Size: 100
    - Class: rviz/Marker
      Enabled: false
      Marker Topic: /planning/travel_traj
      Name: FALCON Command History (Optional)
      Namespaces: {}
      Queue Size: 20
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /pre_map_vln/current_plan
      Name: Current Plan (Amber)
      Namespaces: {}
      Queue Size: 10
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 15; 45; 150
      Enabled: true
      Head Diameter: 0.25
      Head Length: 0.15
      Length: 0.3
      Line Style: Lines
      Line Width: 0.01
      Name: Executed Path (FUEL Blue)
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 90; 30
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.15
      Topic: /pre_map_vln/agent_path
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /pre_map_vln/styled_box_markers
      Name: Boxer 3D Boxes (Styled)
      Namespaces:
        boxer_3d: false
        boxer_labels: false
        boxer_outlines: true
      Queue Size: 10
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: UAV Pose
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 80; 20
        Head Length: 0.2
        Head Radius: 0.08
        Shaft Length: 0.4
        Shaft Radius: 0.04
        Value: Arrow
      Topic: /uav_simulator/odometry
      Unreliable: false
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /pre_map_vln/camera_frustum
      Name: Camera FoV (Actual RGB Direction)
      Namespaces: {}
      Queue Size: 10
    - Class: rviz/Image
      Enabled: true
      Image Topic: /habitat/rgb
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Habitat First Person RGB
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: world
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 17
      Enable Stereo Rendering: false
      Focal Point: {X: 1.5, Y: 2.0, Z: 1.0}
      Name: Roofless Exploration View
      Near Clip Distance: 0.01
      Pitch: 1.05
      Target Frame: world
      Yaw: 3.9
Window Geometry:
  Height: 900
  Width: 1080
  X: 20
  Y: 40
