Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Metric Grid
      Plane: XY
      Reference Frame: world
    - Alpha: 0.48
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 185; 185; 185
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Explored Boundary Map
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.02
      Style: Points
      Topic: /voxel_mapping/occupancy_grid_occupied
      Unreliable: false
      Use Fixed Frame: true
    - Alpha: 0.78
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 120; 25
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Frontier Cells
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.06
      Style: Points
      Topic: /planning_vis/frontier_pcl
      Unreliable: false
      Use Fixed Frame: true
    - Class: rviz/Marker
      Enabled: false
      Marker Topic: /planning_vis/frontier
      Name: Frontier Labels (Optional)
      Namespaces: {}
      Queue Size: 100
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /planning/travel_traj
      Name: Executed Trajectory
      Namespaces: {}
      Queue Size: 30
    - Alpha: 0.9
      Buffer Length: 1
      Class: rviz/Path
      Color: 35; 220; 105
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.2
      Line Style: Lines
      Line Width: 0.012
      Name: Agent Path
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Color: 255; 90; 30
      Pose Style: None
      Radius: 0.02
      Shaft Diameter: 0.04
      Shaft Length: 0.1
      Topic: /pre_map_vln/agent_path
    - Angle Tolerance: 0.1
      Class: rviz/Odometry
      Enabled: true
      Keep: 1
      Name: Agent Pose
      Position Tolerance: 0.1
      Shape:
        Alpha: 0.85
        Axes Length: 0.25
        Axes Radius: 0.025
        Color: 255; 80; 20
        Head Length: 0.12
        Head Radius: 0.05
        Shaft Length: 0.24
        Shaft Radius: 0.025
        Value: Arrow
      Topic: /uav_simulator/odometry
      Unreliable: false
  Enabled: true
  Global Options:
    Background Color: 25; 28; 32
    Default Light: true
    Fixed Frame: world
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering: false
      Invert Z Axis: false
      Name: Top-down Exploration
      Near Clip Distance: 0.01
      Scale: 75
      Target Frame: world
      X: 1.5
      Y: 2.5
Window Geometry:
  Height: 900
  Width: 760
  X: 1110
  Y: 40
