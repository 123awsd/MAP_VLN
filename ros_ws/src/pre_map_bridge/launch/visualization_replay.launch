<launch>
  <arg name="bag_path" default="/workspace/shared/outputs/bags/hm3d_visualization.bag"/>
  <arg name="loop" default="false"/>
  <param name="/use_sim_time" value="true"/>
  <node pkg="rviz" type="rviz" name="pre_map_vln_rviz" output="screen"
        args="-d $(find pre_map_bridge)/config/stage1.rviz"/>
  <node unless="$(arg loop)" pkg="rosbag" type="play" name="stage1_bag_player" output="screen" required="true"
        args="--clock $(arg bag_path)"/>
  <node if="$(arg loop)" pkg="rosbag" type="play" name="stage1_bag_player_loop" output="screen" required="true"
        args="--clock --loop $(arg bag_path)"/>
</launch>
