<launch>
  <arg name="bag_path" default="/workspace/shared/outputs/bags/hm3d_stage2_complete.bag"/>
  <arg name="loop" default="false"/>
  <arg name="rate" default="1.0"/>
  <arg name="delay" default="2.0"/>
  <param name="/use_sim_time" value="true"/>
  <node pkg="pre_map_bridge" type="roofless_visualization_node.py"
        name="roofless_visualization" output="screen"/>
  <node pkg="rviz" type="rviz" name="pre_map_vln_stage2_rviz" output="screen"
        args="-d $(find pre_map_bridge)/config/stage2.rviz"/>
  <node unless="$(arg loop)" pkg="rosbag" type="play" name="stage2_bag_player" output="screen"
        args="--quiet --clock --delay=$(arg delay) -r $(arg rate) $(arg bag_path)"/>
  <node if="$(arg loop)" pkg="rosbag" type="play" name="stage2_bag_player_loop" output="screen"
        args="--quiet --clock --loop --delay=$(arg delay) -r $(arg rate) $(arg bag_path)"/>
</launch>
